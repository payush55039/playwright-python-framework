# Copy this file to .env and adjust values as needed.
# Any variable set here (or exported in your shell/CI) overrides the
# matching key in config.yaml -- no source code changes required.

ENV=qa
BROWSER=chromium
HEADLESS=true
BASE_URL=https://www.saucedemo.com
TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
RETRY_COUNT=2
SLOW_MO=0
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
SCREENSHOT_ON_FAILURE=true
VIDEO_MODE=retain-on-failure
TRACE_MODE=retain-on-failure
LOG_LEVEL=INFO
